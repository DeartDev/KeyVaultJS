# ==========================================
# Frontend / Web Project .gitignore
# ==========================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editores y Entornos de Desarrollo (IDEs)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Node.js (Si decides usar NPM/Yarn en el futuro para dependencias como Tailwind o Vite)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos de Build (Si en el futuro usas un bundler como Webpack o Vite)
dist/
build/
.cache/
out/

# Logs
logs
*.log

# Archivos de entorno y secretos
# IMPORTANTE: Nunca subir el .env donde podrías guardar claves de APIs si algún día cambias a usar backend.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos temporales
*.tmp
*.temp
