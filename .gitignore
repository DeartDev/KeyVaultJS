# ==========================================
# KeyVault - .gitignore
# ==========================================

# ---------- OS generated files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------- Editores / IDEs ----------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# NOTA: package-lock.json SÍ se commitea (builds reproducibles).

# ---------- Build artifacts ----------
dist/
build/
.cache/
out/

# ---------- Logs ----------
logs/
*.log

# ---------- Archivos de entorno y secretos ----------
# NUNCA subir .env: contiene credenciales de Postgres y secrets JWT.
.env
.env.local
.env.*.local
deploy/.env

# ---------- Backups de base de datos ----------
*.sql
*.sql.gz
*.dump
backup*/
pgdata/

# ---------- Docker (volúmenes locales / bind mounts) ----------
# Los volúmenes nombrados los gestiona Docker; esto cubre bind mounts accidentales.
*.docker-volume/

# ---------- Temporales ----------
*.tmp
*.temp
*.bak
