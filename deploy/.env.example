# ==========================================
# KeyVaultJS - Environment configuration
# ==========================================
# Copy this file to ".env" and fill the values.
# deploy/deploy.sh lo crea automáticamente (con secrets generados) y le aplica
# chmod 600. Si se crea a mano:
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=keyvault
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=keyvault

# Connection string used internally by the API container.
# Composed automatically by docker-compose from the values above.
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- JWT (generate with:  openssl rand -hex 32) ---
JWT_SECRET=replace_with_32_byte_hex_secret_1
JWT_REFRESH_SECRET=replace_with_32_byte_hex_secret_2

# --- Token lifetimes (optional) ---
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Bcrypt cost factor (optional) ---
BCRYPT_ROUNDS=12

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info

# --- Vault size limit (bytes, optional) ---
VAULT_MAX_BYTES=1048576

# --- Reverse proxy (nº de saltos de confianza para X-Forwarded-For) ---
# 1 = solo nginx del contenedor web. Con Apache delante sigue siendo 1,
# porque nginx reescribe la cadena X-Forwarded-For que recibe de Apache.
TRUST_PROXY_HOPS=1

# --- Rate limiting de /api/auth/* (ventana en ms y máximos por ventana) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_IP=20
RATE_LIMIT_AUTH_MAX_EMAIL=10

# --- Purga de refresh_tokens expirados/revocados (días de retención) ---
REFRESH_TOKEN_PURGE_DAYS=30
